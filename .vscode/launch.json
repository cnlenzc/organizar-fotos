  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "Simular",
      "skipFiles": ["<node_internals>/**"],
      "program": "${workspaceFolder}\\index.js",
      "args": ["--simular", "--limite", "20"]
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Mover",
      "skipFiles": ["<node_internals>/**"],
      "program": "${workspaceFolder}\\index.js",
      "args": ["--limite", "10000"]
    }
  ]
}
